diff --git a/scripts/toolchain.lua b/scripts/toolchain.lua
index 14a374c3..fd448bad 100644
--- a/scripts/toolchain.lua
+++ b/scripts/toolchain.lua
@@ -20,6 +20,7 @@ newoption {
 		{ "android-x86",   "Android - x86"          },
 		{ "android-x64",   "Android - x64"          },
 		{ "asmjs",         "Emscripten/asm.js"      },
+		{ "wii",           "Nintendo Wii (devkitPPC)" },
 		{ "freebsd",       "FreeBSD"                },
 		{ "freebsd-clang", "FreeBSD (clang compiler)"},
 		{ "linux-gcc",     "Linux (GCC compiler)"   },
@@ -114,6 +115,16 @@ function toolchain(_buildDir, _subDir)
 			location (_buildDir .. "projects/" .. _subDir .. "/".. _ACTION .. "-asmjs")
 		end
 
+		if "wii" == _OPTIONS["gcc"] then
+			if not os.getenv("DEVKITPPC") then
+				print("Set DEVKITPPC environment variable.")
+			end
+			premake.gcc.cc   = "$(DEVKITPPC)/bin/powerpc-eabi-gcc"
+			premake.gcc.cxx  = "$(DEVKITPPC)/bin/powerpc-eabi-g++"
+			premake.gcc.ar   = "$(DEVKITPPC)/bin/powerpc-eabi-ar"
+			location (_buildDir .. "projects/" .. _subDir .. "/".. _ACTION .. "-wii")
+		end
+
 		if "freebsd" == _OPTIONS["gcc"] then
 			location (_buildDir .. "projects/" .. _subDir .. "/".. _ACTION .. "-freebsd")
 		end
@@ -529,6 +540,45 @@ function toolchain(_buildDir, _subDir)
 			"-Wno-extern-c-compat",
 		}
 
+	configuration { "wii" }
+		targetdir (_buildDir .. "wii" .. "/bin")
+		objdir (_buildDir .. "wii" .. "/obj")
+		defines {
+			"GEKKO",
+			"HW_RVL",
+		}
+		buildoptions {
+			"-mrvl",
+			"-mcpu=750",
+			"-meabi",
+			"-mhard-float",
+			"-ffunction-sections",
+			"-fdata-sections",
+			"-isystem $(DEVKITPRO)/libogc/include",
+			"-isystem $(DEVKITPRO)/portlibs/ppc/include",
+			"-Wno-cast-align",
+		}
+		buildoptions_cpp {
+			-- devkitPPC's <limits.h> only defines the long long limits for C;
+			-- supply them for C++ (compatible with <climits> and the PCH)
+			"-DLLONG_MAX=__LONG_LONG_MAX__",
+			"'-DLLONG_MIN=(-__LONG_LONG_MAX__-1LL)'",
+			"'-DULLONG_MAX=(__LONG_LONG_MAX__*2ULL+1ULL)'",
+		}
+		linkoptions {
+			"-mrvl",
+			"-mcpu=750",
+			"-meabi",
+			"-mhard-float",
+			"-Wl,--gc-sections",
+			"-Wl,-Map,$(TARGET).map",
+			-- MAME is far larger than MEM1 (24 MB): code goes to MEM2,
+			-- writable data stays in MEM1 (see the linker script)
