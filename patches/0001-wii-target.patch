index fe983b80..b4837038 100644
--- a/makefile
+++ b/makefile
@@ -399,6 +399,20 @@ ifndef NOASM
 endif
 endif
 
+# Nintendo Wii (devkitPPC)
+ifeq ($(TARGETOS),wii)
+ifndef DEVKITPPC
+$(error DEVKITPPC is not set)
+endif
+ARCHITECTURE :=
+PLATFORM := powerpc
+BIGENDIAN := 1
+NOASM := 1
+ifndef OSD
+OSD := wii
+endif
+endif
+
 ifeq ($(findstring aarch64,$(UNAME)),aarch64)
 ARCHITECTURE :=
 endif
@@ -440,7 +454,11 @@ else
 PYTHON := $(PYTHON_EXECUTABLE)
 endif
 
-ifneq ($(TARGETOS),asmjs)
+ifeq ($(TARGETOS),wii)
+CC := $(SILENT)$(DEVKITPPC)/bin/powerpc-eabi-gcc
+LD := $(SILENT)$(DEVKITPPC)/bin/powerpc-eabi-g++
+CXX:= $(SILENT)$(DEVKITPPC)/bin/powerpc-eabi-g++
+else ifneq ($(TARGETOS),asmjs)
 CC := $(SILENT)gcc
 LD := $(SILENT)g++
 CXX:= $(SILENT)g++
@@ -1246,6 +1264,24 @@ endif
 	$(SILENT) $(MAKE) $(MAKEPARAMS) -C $(PROJECTDIR)/$(MAKETYPE)-asmjs config=$(CONFIG) precompile
 	$(SILENT) $(MAKE) $(MAKEPARAMS) -C $(PROJECTDIR)/$(MAKETYPE)-asmjs config=$(CONFIG)
 
+#-------------------------------------------------
+# Nintendo Wii (devkitPPC)
+#-------------------------------------------------
+
+$(PROJECTDIR)/$(MAKETYPE)-wii/Makefile: makefile $(SCRIPTS) $(GENIE)
+ifndef DEVKITPPC
+	$(error DEVKITPPC is not set)
+endif
+	$(SILENT) $(GENIE) $(PARAMS) $(TARGET_PARAMS) --gcc=wii --gcc_version=$(GCC_VERSION) $(MAKETYPE)
+
+.PHONY: wii
+wii: generate $(PROJECTDIR)/$(MAKETYPE)-wii/Makefile
+ifndef DEVKITPPC
+	$(error DEVKITPPC is not set)
+endif
+	$(SILENT) $(MAKE) $(MAKEPARAMS) -C $(PROJECTDIR)/$(MAKETYPE)-wii config=$(CONFIG) precompile
+	$(SILENT) $(MAKE) $(MAKEPARAMS) -C $(PROJECTDIR)/$(MAKETYPE)-wii config=$(CONFIG)
+
